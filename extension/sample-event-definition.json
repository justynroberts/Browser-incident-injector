          "component": "{{component}}",
          "group": "market-data",
          "class": "latency",
          "custom_details": {
            "metric": "market_data_latency_p95",
            "current_value": "847ms",
            "threshold": "500ms",
            "source": "nasdaq_feed_monitor",
            "affected_symbols": "AAPL,MSFT,GOOGL",
            "monitoring_tool": "DataDog",
